    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="#//SubscriptionStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subscriber" lowerBound="1"
        eType="#//Member"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="payments" lowerBound="1"
        eType="#//Payments" eOpposite="#//Payments/subscriptions"/>
