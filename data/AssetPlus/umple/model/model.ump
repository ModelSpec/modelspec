class AssetPlus {
  1 <@>- * Employee employees;
  1 <@>- * Guest guests;
  1 <@>- 0..1 Manager manager;
  1 <@>- * MaintenanceTicket maintenanceTickets;
  1 <@>- * AssetType assetTypes;
  1 <@>- * SpecificAsset specificAssets;
}

class User {
  abstract;
  unique String email;
  String name;
  String password;
  String phoneNumber;
}

class HotelStaff {
  isA User;
  abstract;
}

class Guest {
  isA User;
}

class Employee {
  isA HotelStaff;
}

class Manager {
  isA HotelStaff;
}

class MaintenanceTicket {
  1 ticket <@>- * MaintenanceNote ticketNotes;
  1 ticket <@>- * TicketImage ticketImages;

  unique Integer id;
  date raisedOnDate;
  String description;

  enum TimeEstimate{lessThanADay, oneToThreeDays, threeToSevenDays, oneToThreeWeeks, threeOrMoreWeeks}
  lazy TimeEstimate timeToResolve;

  enum PriorityLevel {Urgent, Normal, Low}
  lazy PriorityLevel priority;
}

class MaintenanceNote {
  date date;
  String description;
}

class TicketImage {
  String imageURL;
}

class SpecificAsset {
  unique Integer assetNumber;
  Integer floorNumber;
  Integer roomNumber;
  date purchaseDate;
}

class AssetType {
  unique String name;
  Integer expectedLifeSpan;
  lazy String image;
}

association {
  1 User ticketRaiser -- * MaintenanceTicket raisedTickets;  
}

association {
  1 HotelStaff noteTaker -- * MaintenanceNote maintenanceNotes;  
}

association {
  0..1 HotelStaff ticketFixer -- * MaintenanceTicket maintenanceTasks;
}

association {
  0..1 SpecificAsset asset -- * MaintenanceTicket maintenanceTickets;
}

association {
  1 AssetType assetType -- * SpecificAsset specificAssets;
}

association {
  0..1 Manager fixApprover -- * MaintenanceTicket ticketsForApproval;
}
class TOMaintenanceNote {
  immutable;
  date date;
  String description;
  String noteTakerEmail;
}

class TOUser {
  abstract;
  immutable;
  String email;
  String name;
  String password;
  String phoneNumber;
  Integer[] ticketsRaised;
}

class TOGuest {
  immutable;
  isA TOUser;
}

class TOHotelStaff {
  abstract;
  immutable;
  isA TOUser;
  Integer[] ticketFixed;
}

class TOEmployee {
  immutable;
  isA TOHotelStaff;
}

class TOManager {
  immutable;
  isA TOHotelStaff;
  Integer[] ticketApproved;
}

class TOAssetType {
  immutable;
  String name;
  Integer expectedLifeSpan;
  lazy String imageURL;
}

class TOSpecificAsset {
  immutable;
  Integer assetNumber;
  Integer floorNumber;
  Integer roomNumber;
  date purchaseDate;
  TOAssetType assetType;
}

class TOMaintenanceTicket {
  immutable;
  Integer id;
  date raisedOnDate;
  String description;
  String raisedByEmail;

  String status;

  String fixedByEmail;
  String timeToResolve;
  String priority;
  Boolean approvalRequired;
  String assetName;
  Integer expectedLifeSpanInDays;
  date purchaseDate;
  Integer floorNumber;
  Integer roomNumber;
  String[] imageURLs;
  date[] noteDates;
  String[] noteDescriptions;
  String[] noteTakerEmails;
}